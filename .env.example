# Frontend (Vite) environment configuration.
# Copy to .env (git-ignored) for local development and fill in real values.

# ─── Meta Pixel (GDPR consent-gated) ──────────────────────────────────────────
# Pixel ID from Meta Events Manager. Not a secret, but the production value is
# deployment configuration and must never be committed here or hardcoded in
# source — see src/app/analytics/metaPixel.ts. Leave blank to disable the
# Meta Pixel entirely (no script load, no fbq init, no runtime error).
VITE_META_PIXEL_ID=

# ─── "Още игри" / Ludo (Не се сърди човече) — work in progress ────────────────
# Set to true to reveal the "Още игри" lobby section and the Ludo visual
# prototype locally. Leave blank/false in every deployed environment until the
# feature is ready — see src/app/games/ludo/ludoFeatureFlag.ts.
VITE_FEATURE_LUDO=
