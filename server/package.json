    "check:client-winning-bid": "tsx scripts/checkClientWinningBidHelpers.ts",
    "check:password-reset": "tsx scripts/checkPasswordReset.ts",
    "check:password-reset-http": "tsx scripts/checkPasswordResetHttp.ts",
    "check:friend-acceptance": "tsx scripts/checkFriendAcceptanceNotifications.ts",
    "check:round-capot-mission": "tsx scripts/checkRoundCapotMission.ts",
    "check:partner-suit-all-trumps": "tsx scripts/checkPartnerSuitAllTrumpsLead.ts",
