    "check:view-layout-tracking": "tsx scripts/checkViewLayoutTracking.ts",
    "check:view-layout-frontend": "tsx scripts/checkViewLayoutFrontend.ts --project-root=..",
    "check:visitor-summary": "tsx scripts/checkVisitorSummary.ts",
    "check:device-type": "tsx scripts/checkDeviceType.ts",
    "check:device-migration": "tsx scripts/checkDeviceMigration.ts --server-root=.",
    "check:os-type": "tsx scripts/checkOsType.ts",
    "check:os-migration": "tsx scripts/checkOsMigration.ts --server-root=.",
