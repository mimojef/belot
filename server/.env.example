STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CLIENT_ORIGIN=http://localhost:5173
STRIPE_SUCCESS_URL=http://localhost:5173/?screen=shop&payment=success&session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:5173/?screen=shop&payment=cancel
BREVO_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
CONTACT_FROM_NAME=Pika.bg
PASSWORD_RESET_URL=http://localhost:5173/reset-password
PASSWORD_RESET_RATE_LIMIT_SECRET=
# Base URL за "Въведете кода тук" линка в registration verification email-а
# (dedicated /verify-registration страница) — mirror на PASSWORD_RESET_URL.
# Ако липсва, email-ът просто не съдържа линк (само кода, старото поведение) —
# fail-safe, не fail-closed (регистрацията си остава напълно функционална
# без него, потребителят просто въвежда кода от старото popup flow).
REGISTRATION_VERIFICATION_URL=http://localhost:5173/verify-registration
PIKA_TEAM_GIFT_BYPASS_PROFILE_ID=
# Official Pika.bg profile allowed to keep/use the reserved display name PIKABG.
# Also the ONLY profileId allowed to start an official "pika_support" chat
# with an arbitrary registered user (bypasses the normal friendship guard —
# see chatStore.getOrCreatePikaSupportConversation). Leave blank to disable
# both features (fail-closed: no PIKABG reservation, no chat bypass).
PIKA_OFFICIAL_PROFILE_ID=
