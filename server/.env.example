STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CLIENT_ORIGIN=http://localhost:5173
STRIPE_SUCCESS_URL=http://localhost:5173/?screen=shop&payment=success&session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:5173/?screen=shop&payment=cancel
BREVO_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
CONTACT_FROM_NAME=Pika.bg
PASSWORD_RESET_URL=http://localhost:5173/reset-password
PASSWORD_RESET_RATE_LIMIT_SECRET=

# ─── AI Training Recorder (disabled by default) ───────────────────────────────
# Set TRAINING_RECORDER_ENABLED=true to start recording deals.
# TRAINING_RECORDER_HASH_SECRET must be at least 16 characters.
# Never share or commit the real secret — this file is safe because the value is blank.
TRAINING_RECORDER_ENABLED=false
TRAINING_RECORDER_HASH_SECRET=
TRAINING_RECORDER_PATH=./training-recordings
TRAINING_RECORDER_MAX_FILE_MB=100
TRAINING_RECORDER_MAX_TOTAL_GB=10
TRAINING_RECORDER_MAX_QUEUE=1000
TRAINING_RECORDER_RETENTION_DAYS=90

# ─── Local AI Card-Play Beta (local-only, disabled by default) ────────────────
# Experimental card-play candidate for BOT seats only — bidding stays on the
# conventional bot. Requires a local-only model.json artifact produced by
# `npm run train:card-model` (never committed, never present in production).
# When OFF (default), runtime behaviour is byte-for-byte identical to before.
# Do NOT enable this in production — it is a local developer experiment.
LOCAL_AI_CARD_BETA_ENABLED=false
# Optional override — defaults to training-output/models/card-model-v1/model.json
LOCAL_AI_CARD_BETA_MODEL_PATH=
