# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# scripts/deployFrontendAtomic.sh runtime artifacts — DEPLOY_ROOT по
# подразбиране съвпада с repo checkout-а (/var/www/belot-v2), значи тези
# директории се появяват като sibling-и на src/, server/ и т.н. Leading
# slash е задължителен — без него "assets" би игнорирал и тракнатия
# public/assets/.
/releases
/assets
/current

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Runtime database files
server/database/data/

# Database backups — генерирани на сървъра, не в git
server/database/backups/

# Компилирани backup/verify скриптове
server/dist-scripts/

# Environment variables (never commit real secrets)
.env
server/.env

# Runtime user uploads - не включвай в git
server/uploads/*
!server/uploads/.gitkeep
!server/uploads/avatars/
server/uploads/avatars/*
!server/uploads/avatars/.gitkeep
!server/uploads/profile-gallery/
server/uploads/profile-gallery/**
!server/uploads/profile-gallery/.gitkeep

# AI training dataset builder — generated local output, никога не се commit-ва
training-output/

# Training recorder audit архиви, свалени локално за dataset export
training-recorder-audit-*.tar.gz
